<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>İyi ki Doğdun Simay 💖</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

<style>
:root {
  --pink: #ff4d88;
  --soft: #fff1f5;
  --text: #2a2a2a;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(to bottom, #ffffff, var(--soft));
  color: var(--text);
}

.container {
  max-width: 1100px;
  margin: auto;
  padding: 40px 20px;
}

header {
  text-align: center;
  margin-bottom: 40px;
}

h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem,5vw,3rem);
  color: var(--pink);
}

.subtitle {
  color: #888;
  margin-top: 10px;
}

.card {
  background: white;
  border-radius: 20px;
  padding: 30px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  margin-bottom: 40px;
  animation: fadeUp 1s ease;
}

@keyframes fadeUp {
  from {opacity:0; transform:translateY(30px);} 
  to {opacity:1; transform:translateY(0);} 
}

.message {
  line-height: 1.9;
  font-size: 1.05rem;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}

.photo {
  position: relative;
  overflow: hidden;
  border-radius: 20px;
}

.photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.photo:hover img {
  transform: scale(1.1);
}

.photo::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
}

.button {
  display: inline-block;
  margin-top: 30px;
  padding: 14px 30px;
  border-radius: 30px;
  background: var(--pink);
  color: white;
  font-weight: 500;
  cursor: pointer;
  transition: 0.3s;
}

.button:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(255,77,136,0.4);
}

.footer {
  margin-top: 60px;
  text-align: center;
  color: #aaa;
  font-size: 0.9rem;
}

.confetti, .heart {
  position: fixed;
  top: -10px;
  animation: fall linear forwards;
  pointer-events: none;
}

@keyframes fall {
  to { transform: translateY(100vh); }
}

</style>
</head>

<body>

<div class="container">

<header>
  <h1>İyi ki Doğdun Simay 🎂</h1>
  <div class="subtitle">Bazı insanlar sadece hayatına girmez… iz bırakır 💖</div>
</header>

<div class="card" onclick="celebrate()">
  <div class="message">
Simay,<br><br>
Bazı insanlar hayatına öğretmen olarak girer, bazıları arkadaş olarak. Sen ikisi birden girdin ve bir de baktım, çok daha fazlası olmuşsun. 🌿<br><br>
Mangaldaki o duman, sarımsağı ezişin, kafedeki zor seçimin… Seninle vakit geçirmek her zaman güzeldi ve her zaman güzel olacak.<br><br>
Büyük şeyler olmak zorunda değil, sadece sen buradayken yeterince güzel ve eğlenceli. ✨ Seni tanıdığım için şanslıyım. Yanında olmak, seninle bir şeyler yapmak beni çok mutlu ediyor. Hepsi benim için çok değerliydi.<br><br>
İyi ki doğdun, iyi ki varsın arkadaşım, öğretmenim ve ablam… 🌸<br><br>
— Yiğit
  </div>
</div>

<div class="gallery">
  <div class="photo"><img src="photo1.jpg"></div>
  <div class="photo"><img src="photo2.jpg"></div>
  <div class="photo"><img src="photo3.jpg"></div>
</div>

<div style="text-align:center">
  <div class="button" onclick="celebrate()">Kutlamaya Başla 💖</div>
</div>

<div class="footer">
  Senin için hazırlandı ✨
</div>

</div>

<script>
function createConfetti() {
  const emojis = ['💖','✨','🌸'];
  for (let i = 0; i < 30; i++) {
    const el = document.createElement('div');
    el.className = 'confetti';
    el.style.left = Math.random() * 100 + 'vw';
    el.innerText = emojis[Math.floor(Math.random() * emojis.length)];
    el.style.fontSize = Math.random()*20+10+'px';
    el.style.animationDuration = Math.random()*3+2+'s';
    document.body.appendChild(el);
    setTimeout(()=>el.remove(),4000);
  }
}

function heartExplosion() {
  for (let i = 0; i < 20; i++) {
    const heart = document.createElement('div');
    heart.className = 'heart';
    heart.innerText = '💗';
    heart.style.left = (window.innerWidth/2 - 10) + 'px';
    heart.style.fontSize = Math.random()*20+15+'px';
    heart.style.animationDuration = Math.random()*2+2+'s';
    document.body.appendChild(heart);
    setTimeout(()=>heart.remove(),4000);
  }
}

function celebrate() {
  createConfetti();
  heartExplosion();
}

window.addEventListener("load", createConfetti);
</script>

</body>
</html>
