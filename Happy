<!DOCTYPE html>

<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>İyi Ki Doğdun Simay 🌸</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@200;300;400&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }

body {
font-family: ‘Jost’, sans-serif;
background: #faf7f4;
color: #1a1218;
overflow-x: hidden;
}

#confetti-canvas {
position: fixed; top:0; left:0;
width:100%; height:100%;
pointer-events:none; z-index:1000;
}

/* HERO */
.hero {
min-height: 100vh;
background: #1a1218;
display: flex;
flex-direction: column;
justify-content: center;
padding: 6rem 4rem 4rem;
position: relative;
overflow: hidden;
}
.hero-glow {
position: absolute; inset: 0; pointer-events: none;
background:
radial-gradient(ellipse 70% 50% at 70% 40%, rgba(232,160,176,0.15) 0%, transparent 60%),
radial-gradient(ellipse 50% 70% at 20% 80%, rgba(158,184,158,0.1) 0%, transparent 55%);
}
.hero-tag {
font-size: 0.7rem; letter-spacing: 0.4em;
text-transform: uppercase; color: #c9a96e;
margin-bottom: 2rem;
opacity:0; animation: up 0.9s 0.3s forwards;
}
.hero-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(4.5rem, 13vw, 10rem);
font-weight: 300; line-height: 0.92;
color: #ffffff;
opacity:0; animation: up 0.9s 0.5s forwards;
}
.hero-title em { font-style:italic; color:#e8a0b0; display:block; }
.hero-sub {
margin-top: 2.5rem; font-weight:200;
font-size: 1rem; letter-spacing:0.15em;
color: rgba(255,255,255,0.4);
opacity:0; animation: up 0.9s 0.8s forwards;
}
.hero-line {
position: absolute; bottom: 3rem; left: 4rem;
display: flex; align-items: center; gap: 1rem;
opacity:0; animation: fadeIn 1s 1.6s forwards;
}
.hero-line span {
font-size: 0.62rem; letter-spacing:0.3em;
text-transform:uppercase; color:rgba(255,255,255,0.2);
}
.line-bar {
width: 50px; height: 1px;
background: rgba(255,255,255,0.15); overflow:hidden; position:relative;
}
.line-bar::after {
content:’’; position:absolute; left:-100%; width:100%; height:100%;
background: #c9a96e; animation: scan 2.5s 2s infinite;
}

/* DIVIDER */
.divider {
height: 1px; margin: 0 5rem;
background: linear-gradient(90deg, transparent, #e8a0b0, transparent);
opacity: 0.25;
}

/* NOTE */
.note-wrap {
background: #faf7f4;
padding: 7rem 5rem;
}
.note-inner {
max-width: 900px; margin: 0 auto;
display: grid; grid-template-columns: auto 1fr; gap: 5rem; align-items: start;
}
.note-side {
display: flex; flex-direction: column; align-items: center; gap: 1rem;
padding-top: 0.5rem;
}
.note-num {
font-family:‘Cormorant Garamond’,serif;
font-size: 5rem; font-weight:300; color:#f0eae8; line-height:1;
}
.note-vert {
font-size:0.62rem; letter-spacing:0.35em;
text-transform:uppercase; color:#c9a96e;
writing-mode:vertical-rl; transform:rotate(180deg);
}
.note-heading {
font-family:‘Cormorant Garamond’,serif;
font-size: clamp(2.2rem,4.5vw,3.5rem);
font-weight:300; line-height:1.1; margin-bottom:2rem;
}
.note-heading em { font-style:italic; color:#e8a0b0; }
.note-card {
background: #ffffff;
border-radius: 1.5rem;
padding: 3rem 3rem;
border-left: 3px solid #e8a0b0;
box-shadow: 0 4px 40px rgba(232,160,176,0.12);
position: relative; overflow:hidden;
}
.note-card::before {
content:’”’;
font-family:‘Cormorant Garamond’,serif;
font-size:12rem; color:#f5e6ea;
position:absolute; top:-2.5rem; left:1.5rem;
line-height:1; pointer-events:none; user-select:none;
}
.note-text {
font-family:‘Cormorant Garamond’,serif;
font-size:1.3rem; line-height:2;
color:#5a3d45; position:relative; z-index:1;
}
.note-sign {
margin-top:2rem; font-size:0.85rem;
letter-spacing:0.1em; color:#c9a96e;
position:relative; z-index:1;
}

/* GALLERY */
.gallery-wrap {
background: #1a1218;
padding: 6rem 5rem;
position: relative; overflow:hidden;
}
.gallery-wrap::before {
content:’’; position:absolute; inset:0; pointer-events:none;
background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(232,160,176,0.05) 0%, transparent 70%);
}
.gallery-head {
display:flex; justify-content:space-between;
align-items:flex-end; margin-bottom:3.5rem; position:relative; z-index:1;
}
.gallery-title {
font-family:‘Cormorant Garamond’,serif;
font-size: clamp(2.2rem,4.5vw,3.5rem);
font-weight:300; color:#ffffff; line-height:1.1;
}
.gallery-title em { font-style:italic; color:#e8a0b0; }
.gallery-tag {
font-size:0.62rem; letter-spacing:0.35em;
text-transform:uppercase; color:rgba(255,255,255,0.25);
}
.gallery-grid {
display:grid; grid-template-columns: 1fr 1fr 1fr;
gap:1.25rem; position:relative; z-index:1;
align-items: start;
}
.photo-frame {
border-radius:1rem; overflow:hidden;
position:relative; cursor:pointer;
transition: transform 0.4s cubic-bezier(.2,.8,.3,1);
}
.photo-frame:nth-child(1) { margin-top: 2rem; }
.photo-frame:nth-child(3) { margin-top: 4rem; }
.photo-frame:hover { transform: translateY(-6px); }
.photo-frame img {
width:100%; height:100%;
display:block;
object-fit:contain;
transition: transform 0.5s;
}
.photo-frame:hover img { transform:scale(1.03); }
.photo-caption {
position:absolute; bottom:1rem; left:1rem; z-index:2;
font-size:0.62rem; letter-spacing:0.2em;
text-transform:uppercase; color:rgba(255,255,255,0.8);
text-shadow: 0 1px 4px rgba(0,0,0,0.5);
}

/* WISHES */
.wishes-wrap {
background: #faf7f4;
padding: 7rem 5rem;
}
.wishes-inner { max-width:900px; margin:0 auto; }
.wishes-tag {
font-size:0.62rem; letter-spacing:0.35em;
text-transform:uppercase; color:#c9a96e; margin-bottom:1rem;
}
.wishes-title {
font-family:‘Cormorant Garamond’,serif;
font-size:clamp(2.2rem,4.5vw,3.5rem);
font-weight:300; line-height:1.1; margin-bottom:3rem;
}
.wishes-title em { font-style:italic; color:#e8a0b0; }
.wishes-grid {
display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;
}
.wish-card {
background:#ffffff; border-radius:1rem;
padding:2.5rem; border-top:3px solid #e8a0b0;
box-shadow:0 4px 20px rgba(0,0,0,0.05);
transition: transform 0.3s;
}
.wish-card:hover { transform:translateY(-4px); }
.wish-icon { font-size:1.75rem; margin-bottom:0.75rem; }
.wish-name {
font-family:‘Cormorant Garamond’,serif;
font-size:1.4rem; margin-bottom:0.5rem; color:#1a1218;
}
.wish-desc { font-size:0.9rem; font-weight:300; color:#9e8080; line-height:1.7; }

/* FOOTER */
.footer {
background:#1a1218; padding:6rem 4rem;
text-align:center; cursor:pointer; position:relative; overflow:hidden;
}
.footer::before {
content:’’; position:absolute; inset:0;
background:radial-gradient(ellipse 50% 60% at 50% 50%, rgba(232,160,176,0.07) 0%, transparent 70%);
pointer-events:none;
}
.footer-big {
font-family:‘Cormorant Garamond’,serif;
font-size:clamp(5rem,15vw,11rem); font-weight:300;
font-style:italic; color:#ffffff; opacity:0.08;
line-height:1; user-select:none;
}
.footer-over {
position:absolute; inset:0;
display:flex; flex-direction:column;
align-items:center; justify-content:center; gap:0.75rem; z-index:2;
}
.footer-icon { font-size:2rem; }
.footer-label {
font-size:0.68rem; letter-spacing:0.35em;
text-transform:uppercase; color:rgba(255,255,255,0.35);
}
.footer-name {
font-family:‘Cormorant Garamond’,serif;
font-style:italic; font-size:1.1rem; color:#e8a0b0;
}
.footer-hint {
font-size:0.58rem; letter-spacing:0.2em;
color:rgba(255,255,255,0.12); margin-top:0.25rem;
}

/* ANIMATIONS */
@keyframes up {
from { opacity:0; transform:translateY(25px); }
to   { opacity:1; transform:translateY(0); }
}
@keyframes fadeIn { to { opacity:1; } }
@keyframes scan { to { left:100%; } }

/* RESPONSIVE */
@media (max-width:768px) {
.hero { padding:5rem 2rem 3rem; }
.hero-line { left:2rem; }
.divider { margin:0 2rem; }
.note-wrap { padding:5rem 2rem; }
.note-inner { grid-template-columns:1fr; gap:2rem; }
.note-side { display:none; }
.gallery-wrap { padding:5rem 2rem; }
.gallery-grid { grid-template-columns:1fr; }
.photo-frame:nth-child(1),
.photo-frame:nth-child(3) { margin-top:0; }
.wishes-wrap { padding:5rem 2rem; }
.wishes-grid { grid-template-columns:1fr; }
.footer { padding:5rem 2rem; }
}
</style>

</head>
<body>

<canvas id="confetti-canvas"></canvas>

<!-- HERO -->

<div class="hero">
  <div class="hero-glow"></div>
  <p class="hero-tag">✦ Doğum günün kutlu olsun ✦</p>
  <h1 class="hero-title">
    İyi Ki<br>
    <em>Doğdun</em>
    Simay
  </h1>
  <p class="hero-sub">Bugün senin günün &nbsp;🌸</p>
  <div class="hero-line">
    <div class="line-bar"></div>
    <span>aşağı kaydır</span>
  </div>
</div>

<!-- NOTE -->

<div class="note-wrap">
  <div class="note-inner">
    <div class="note-side">
      <div class="note-num">01</div>
      <span class="note-vert">Kalpten</span>
    </div>
    <div>
      <h2 class="note-heading">Sana bir şey<br>söylemek <em>istedim…</em></h2>
      <div class="note-card">
        <div class="note-card__bg"></div>
        <p class="note-text">
          Bazı insanlar hayatına öğretmen olarak girer, bazıları arkadaş olarak. Sen ikisi birden girdin ve bir de baktım, çok daha fazlası olmuşsun. 🌿<br><br>
          Mangaldaki o duman, sarımsağı ezişin, kafedeki zor seçimin… Seninle vakit geçirmek her zaman güzeldi ve her zaman güzel olacak.<br><br>
          Büyük şeyler olmak zorunda değil, sadece sen buradayken yeterince güzel ve eğlenceli. ✨ Seni tanıdığım için şanslıyım. Yanında olmak, seninle bir şeyler yapmak beni çok mutlu ediyor. Hepsi benim için çok değerliydi.<br><br>
          İyi ki doğdun, iyi ki varsın arkadaşım, öğretmenim ve ablam… 🌸
        </p>
        <p class="note-sign">— Yiğit 🤍</p>
      </div>
    </div>
  </div>
</div>

<div class="divider"></div>

<!-- GALLERY -->

<div class="gallery-wrap">
  <div class="gallery-head">
    <h2 class="gallery-title">Bizim<br><em>Anılarımız</em></h2>
    <span class="gallery-tag">✦ 02 / Anılar</span>
  </div>
  <div class="gallery-grid">
    <div class="photo-frame">
      <img src="data:image/jpeg;base64," alt="Mangal">
      <span class="photo-caption">Mangal 🔥</span>
    </div>
    <div class="photo-frame">
      <img src="data:image/jpeg;base64," alt="Tatlı an">
      <span class="photo-caption">Tatlı an 🤍</span>
    </div>
    <div class="photo-frame">
      <img src="data:image/jpeg;base64," alt="Kafede">
      <span class="photo-caption">Kafede ☕</span>
    </div>
  </div>
</div>

<div class="divider"></div>

<!-- WISHES -->

<div class="wishes-wrap">
  <div class="wishes-inner">
    <p class="wishes-tag">✦ 03 / Dilekler</p>
    <h2 class="wishes-title">Sana neler<br><em>diliyorum…</em></h2>
    <div class="wishes-grid">
      <div class="wish-card">
        <div class="wish-icon">🌟</div>
        <div class="wish-name">Sağlık</div>
        <div class="wish-desc">Her zaman sağlıklı, dinç ve enerjik olmanı diliyorum.</div>
      </div>
      <div class="wish-card">
        <div class="wish-icon">💫</div>
        <div class="wish-name">Mutluluk</div>
        <div class="wish-desc">Hayatın boyunca gülümsemene neden olacak anlar dolu olsun.</div>
      </div>
      <div class="wish-card">
        <div class="wish-icon">🌺</div>
        <div class="wish-name">Başarı</div>
        <div class="wish-desc">Hedeflediğin her şeye ulaşmanı, hayallerini yaşamanı diliyorum.</div>
      </div>
      <div class="wish-card">
        <div class="wish-icon">🤍</div>
        <div class="wish-name">Sevgi</div>
        <div class="wish-desc">Her zaman sevildiğini hisset, çünkü gerçekten seviliyorsun.</div>
      </div>
    </div>
  </div>
</div>

<!-- FOOTER -->

<div class="footer" onclick="burstConfetti()">
  <div class="footer-big">Simay</div>
  <div class="footer-over">
    <span class="footer-icon">🌸</span>
    <span class="footer-label">İyi ki doğdun, iyi ki varsın</span>
    <span class="footer-name">— Yiğit</span>
    <span class="footer-hint">konfeti için tıkla ✨</span>
  </div>
</div>

<script>
const canvas = document.getElementById('confetti-canvas');
const ctx = canvas.getContext('2d');
canvas.width = window.innerWidth;
canvas.height = window.innerHeight;
window.addEventListener('resize', () => { canvas.width=window.innerWidth; canvas.height=window.innerHeight; });

const COLORS = ['#e8a0b0','#c9a96e','#9eb89e','#f5e6ea','#ffe082','#ce93d8','#ffffff'];
const SHAPES = ['circle','rect','tri'];

class P {
  constructor(burst) { this.burst=burst; this.reset(); }
  reset() {
    if(this.burst) {
      this.x=window.innerWidth/2+(Math.random()-.5)*300;
      this.y=window.innerHeight/2+(Math.random()-.5)*150;
      const a=Math.random()*Math.PI*2, sp=Math.random()*14+5;
      this.vx=Math.cos(a)*sp; this.vy=Math.sin(a)*sp-7;
    } else {
      this.x=Math.random()*canvas.width; this.y=-20;
      this.vx=(Math.random()-.5)*2; this.vy=Math.random()*2+1;
    }
    this.size=Math.random()*8+4;
    this.color=COLORS[Math.floor(Math.random()*COLORS.length)];
    this.shape=SHAPES[Math.floor(Math.random()*SHAPES.length)];
    this.rot=Math.random()*Math.PI*2; this.rs=(Math.random()-.5)*.15;
    this.alpha=1; this.gravity=0.15; this.dead=false;
  }
  update() {
    this.vy+=this.gravity; this.x+=this.vx; this.y+=this.vy; this.rot+=this.rs;
    if(this.burst){ this.alpha-=0.011; if(this.alpha<=0) this.dead=true; }
    else { if(this.y>canvas.height+20) this.dead=true; }
  }
  draw() {
    ctx.save(); ctx.translate(this.x,this.y); ctx.rotate(this.rot);
    ctx.globalAlpha=Math.max(0,this.alpha); ctx.fillStyle=this.color;
    if(this.shape==='circle'){ ctx.beginPath(); ctx.arc(0,0,this.size/2,0,Math.PI*2); ctx.fill(); }
    else if(this.shape==='rect'){ ctx.fillRect(-this.size/2,-this.size/4,this.size,this.size/2); }
    else { ctx.beginPath(); ctx.moveTo(0,-this.size/2); ctx.lineTo(this.size/2,this.size/2); ctx.lineTo(-this.size/2,this.size/2); ctx.closePath(); ctx.fill(); }
    ctx.restore();
  }
}

let particles=[], animId=null;

function loop() {
  ctx.clearRect(0,0,canvas.width,canvas.height);
  particles=particles.filter(p=>!p.dead);
  particles.forEach(p=>{p.update();p.draw();});
  if(particles.length>0) animId=requestAnimationFrame(loop);
  else { ctx.clearRect(0,0,canvas.width,canvas.height); animId=null; }
}

function startRain() {
  for(let i=0;i<90;i++){ const p=new P(false); p.y=Math.random()*canvas.height; particles.push(p); }
  if(!animId) animId=requestAnimationFrame(loop);
  setTimeout(()=>{ particles=particles.filter(p=>p.burst); },5000);
}

function burstConfetti() {
  for(let i=0;i<160;i++) particles.push(new P(true));
  if(!animId) animId=requestAnimationFrame(loop);
}

startRain();
</script>

</body>
</html>
