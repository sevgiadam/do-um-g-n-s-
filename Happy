<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light only">
<title>Naz</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FBF3EE;
    --paper:#FFFDF9;
    --rose:#E7BEB7;
    --rose-deep:#C98D89;
    --wine:#6E2C3B;
    --wine-deep:#4A1D28;
    --gold:#C9A15D;
    --ink:#2B2320;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth; color-scheme:light;}
  body{
    background:var(--cream);
    color:var(--ink);
    font-family:'EB Garamond', serif;
    overflow-x:hidden;
  }
  .display{font-family:'Playfair Display', serif;}
  .scene{
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:8vh 6vw;
    position:relative;
  }
  .eyebrow{
    letter-spacing:0.35em;
    text-transform:uppercase;
    font-size:0.72rem;
    color:var(--rose-deep);
    margin-bottom:1.4rem;
    opacity:0;
    transform:translateY(10px);
    transition:opacity 1s ease, transform 1s ease;
  }
  h1,h2{
    font-weight:600;
    line-height:1.15;
    opacity:0;
    transform:translateY(18px);
    transition:opacity 1.1s ease 0.15s, transform 1.1s ease 0.15s;
  }
  h1{font-size:clamp(2.4rem, 7vw, 4.6rem); font-style:italic; font-weight:500;}
  h2{font-size:clamp(1.9rem, 5vw, 3rem); color:var(--wine);}
  p.lede{
    max-width:560px;
    font-size:clamp(1.05rem, 2.2vw, 1.3rem);
    line-height:1.75;
    margin-top:1.6rem;
    color:#4a3d38;
    opacity:0;
    transform:translateY(18px);
    transition:opacity 1.1s ease 0.35s, transform 1.1s ease 0.35s;
  }
  .scene.is-visible .eyebrow,
  .scene.is-visible h1,
  .scene.is-visible h2,
  .scene.is-visible p.lede{
    opacity:1;
    transform:translateY(0);
  }

  /* HERO */
  #hero{background:radial-gradient(ellipse at 50% 20%, #fff 0%, var(--cream) 65%);}
  .scroll-cue{
    position:absolute;
    bottom:6vh;
    font-size:0.8rem;
    letter-spacing:0.2em;
    color:var(--rose-deep);
    opacity:0.8;
    animation:bob 2.2s ease-in-out infinite;
  }
  @keyframes bob{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(8px);}
  }

  /* PHOTO SCENE */
  #photos{background:var(--paper);}
  .photo-row{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:2.5vw;
    margin-top:3rem;
    flex-wrap:nowrap;
    opacity:0;
    transform:translateY(18px);
    transition:opacity 1.1s ease 0.4s, transform 1.1s ease 0.4s;
  }
  .scene.is-visible .photo-row{opacity:1; transform:translateY(0);}
  .photo-frame{
    width:220px;
    height:280px;
    border-radius:6px;
    overflow:hidden;
    position:relative;
    background:linear-gradient(160deg, #f3e3df, #ece0da);
    box-shadow:0 18px 40px -18px rgba(110,44,59,0.35);
    flex-shrink:0;
  }
  .photo-frame img{
    width:100%; height:100%; object-fit:cover; display:block;
  }
  .photo-fallback{
    display:none;
    width:100%; height:100%;
    align-items:center; justify-content:center;
    text-align:center;
    font-size:0.95rem;
    color:var(--rose-deep);
    padding:1.5rem;
    line-height:1.5;
  }
  .heart-connector{
    width:74px;
    height:74px;
    flex-shrink:0;
  }
  .heart-connector svg{width:100%; height:100%;}
  .heart-connector path{
    fill:none;
    stroke:var(--rose-deep);
    stroke-width:2.2;
    stroke-linecap:round;
    stroke-linejoin:round;
  }
  .photo-caption{
    margin-top:1.8rem;
    font-style:italic;
    color:var(--rose-deep);
    font-size:1.05rem;
    opacity:0;
    transition:opacity 1.1s ease 0.6s;
  }
  .scene.is-visible .photo-caption{opacity:1;}

  /* ANTICIPATION */
  #ask{background:var(--cream);}
  .continue-btn{
    margin-top:2.4rem;
    background:none;
    border:1px solid var(--wine);
    color:var(--wine);
    padding:0.85rem 2.2rem;
    font-family:'EB Garamond', serif;
    font-style:italic;
    font-size:1.05rem;
    border-radius:999px;
    cursor:pointer;
    opacity:0;
    transform:translateY(18px);
    transition:opacity 1.1s ease 0.55s, transform 1.1s ease 0.55s, background 0.3s ease, color 0.3s ease;
  }
  .scene.is-visible .continue-btn{opacity:1; transform:translateY(0);}
  .continue-btn:hover{background:var(--wine); color:var(--paper);}

  /* FINALE */
  #finale{
    background:linear-gradient(180deg, var(--wine-deep), var(--wine) 55%, #7a3444);
    color:var(--paper);
    min-height:100vh;
  }
  #finale .eyebrow{color:var(--gold);}
  #finale h2{color:var(--paper); font-style:italic; font-weight:500;}
  .answer-row{
    margin-top:2.6rem;
    display:flex;
    gap:1.4rem;
    position:relative;
    height:70px;
    align-items:center;
    justify-content:center;
    opacity:0;
    transform:translateY(18px);
    transition:opacity 1.1s ease 0.5s, transform 1.1s ease 0.5s;
  }
  .scene.is-visible .answer-row{opacity:1; transform:translateY(0);}
  .btn{
    font-family:'EB Garamond', serif;
    font-size:1.1rem;
    padding:0.9rem 2.4rem;
    border-radius:999px;
    cursor:pointer;
    border:none;
  }
  #yes-btn{
    background:var(--gold);
    color:var(--wine-deep);
    font-weight:600;
    transition:transform 0.25s ease;
  }
  #yes-btn:hover{transform:scale(1.06);}
  #no-btn{
    background:transparent;
    border:1px solid rgba(255,255,255,0.6);
    color:var(--paper);
    position:relative;
    transition:left 0.18s ease, top 0.18s ease;
  }
  #result{
    margin-top:2.6rem;
    max-width:520px;
    display:none;
    opacity:0;
    transition:opacity 1s ease;
  }
  #result.show{display:block; opacity:1;}
  #result p{font-size:1.2rem; line-height:1.8;}
  .signature{
    margin-top:2.2rem;
    font-family:'Playfair Display', serif;
    font-style:italic;
    font-size:1.5rem;
    color:var(--gold);
  }
  .music-toggle{
    position:fixed;
    bottom:22px;
    right:22px;
    width:48px; height:48px;
    border-radius:50%;
    background:rgba(255,255,255,0.15);
    border:1px solid rgba(255,255,255,0.4);
    color:#fff;
    font-size:1.2rem;
    cursor:pointer;
    display:none;
    align-items:center;
    justify-content:center;
    z-index:50;
    backdrop-filter:blur(4px);
  }
  .music-toggle.show{display:flex;}

  @media (prefers-reduced-motion: reduce){
    *{animation:none !important; transition:none !important;}
  }
  @media (max-width:560px){
    .photo-row{gap:3vw;}
    .photo-frame{width:38vw; height:48vw; max-width:150px; max-height:190px;}
    .heart-connector{width:14vw; height:14vw; max-width:50px; max-height:50px;}
    .photo-fallback{font-size:0.8rem; padding:0.8rem;}
  }
</style>
</head>
<body>

<section class="scene" id="hero">
  <div class="eyebrow">Bizim için</div>
  <h1 class="display">Bir hikaye başlıyor...</h1>
  <div class="scroll-cue">aşağı kaydır ↓</div>
</section>

<section class="scene" id="distance">
  <div class="eyebrow">İlk söz</div>
  <h2 class="display">Aramızda kilometreler var</h2>
  <p class="lede">Ama her gün seninle konuşmak, seninle oyun oynamak, ekranın öbür ucundan bile olsa güne seninle başlayıp seninle bitirmek… Bunların hiçbiri o mesafeyi umursamıyor, ben de umursamıyorum. Sen olunca uzaklık küçülüyor, yavrum.</p>
</section>

<section class="scene" id="photos">
  <div class="eyebrow">İki taraf, bir kalp</div>
  <h2 class="display">Ekranın iki ucundan</h2>
  <div class="photo-row">
    <div class="photo-frame">
      <img src="data:image/jpeg;base64," alt="Yiğit" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
      <div class="photo-fallback">buraya senin<br>fotoğrafın<br>gelecek 🤍</div>
    </div>
    <div class="heart-connector">
      <svg viewBox="0 0 100 100">
        <path d="M50 82 C 20 60, 8 35, 26 20 C 38 10, 50 20, 50 32 C 50 20, 62 10, 74 20 C 92 35, 80 60, 50 82 Z"/>
      </svg>
    </div>
    <div class="photo-frame">
      <img src="data:image/jpeg;base64," alt="Naz" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
      <div class="photo-fallback">buraya senin<br>fotoğrafın<br>gelecek 🤍</div>
    </div>
  </div>
  <div class="photo-caption">Ekranın iki ucundan da olsa, aynı kalbi paylaşıyoruz.</div>
</section>

<section class="scene" id="ask">
  <div class="eyebrow">Sana bir şey sormak istiyorum</div>
  <h2 class="display">Uzun zamandır içimde taşıdığım bir soru var</h2>
  <p class="lede">Hazırsan, aşağı in.</p>
  <button class="continue-btn" onclick="document.getElementById('finale').scrollIntoView({behavior:'smooth'})">devam et</button>
</section>

<section class="scene" id="finale">
  <div class="eyebrow">Naz</div>
  <h2 class="display">Sevgilim olur musun?</h2>
  <div class="answer-row">
    <button class="btn" id="yes-btn" onclick="sayYes()">Evet 🤍</button>
    <button class="btn" id="no-btn" onmouseover="dodge()" onclick="dodge()">Hayır</button>
  </div>
  <div id="result">
    <p>Beni bu kadar mutlu edebildiğin için teşekkür ederim. Uzaklık ne olursa olsun, seninle her gün daha güzel, Naz.</p>
    <div class="signature">— Yiğit</div>
  </div>
</section>

<button class="music-toggle" id="music-toggle" onclick="toggleMusic()">♪</button>
<audio id="bg-music" loop>
  <source src="data:audio/mpeg;base64," type="audio/mpeg">
</audio>

<script src="https://cdnjs.cloudflare.com/ajax/libs/canvas-confetti/1.9.2/confetti.browser.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/emailjs-com@3.2.0/dist/email.min.js"></script>
<script>
  try{
    emailjs.init("ubFBsQ7zfOZe0mMkU");
  } catch(err){}
</script>
<script>
  const scenes = document.querySelectorAll('.scene');
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ e.target.classList.add('is-visible'); }
    });
  }, {threshold:0.35});
  scenes.forEach(s=>observer.observe(s));

  function dodge(){
    const btn = document.getElementById('no-btn');
    const row = btn.parentElement.getBoundingClientRect();
    const maxX = row.width - btn.offsetWidth - 10;
    const maxY = 20;
    const x = Math.random()*maxX - maxX/2;
    const y = Math.random()*maxY - maxY/2;
    btn.style.position='relative';
    btn.style.left = x + 'px';
    btn.style.top = y + 'px';
  }

  function sayYes(){
    document.getElementById('result').classList.add('show');
    const audio = document.getElementById('bg-music');
    audio.currentTime = 0;
    audio.play().catch(()=>{});
    document.getElementById('music-toggle').classList.add('show');
    fireConfetti();
    sendEmails();
  }

  let emailsSent = false;
  function sendEmails(){
    if(emailsSent) return; // aynı ziyarette iki kere göndermesin
    emailsSent = true;
    if(typeof emailjs === 'undefined') return;
    const serviceId = "service_jhkevil";
    const params = {
      name: "Teklif Sitesi",
      title: "Naz \"Evet\" dedi! \uD83C\uDF89",
      message: "Naz teklifini kabul etti! Tebrikler Yi\u011fit \uD83C\uDF89",
      email: ""
    };
    emailjs.send(serviceId, "template_90tc30o", params).catch(()=>{});
    emailjs.send(serviceId, "template_yrefjtd", params).catch(()=>{});
  }

  function toggleMusic(){
    const audio = document.getElementById('bg-music');
    if(audio.paused){ audio.play().catch(()=>{}); }
    else{ audio.pause(); }
  }

  function fireConfetti(){
    if (typeof confetti !== 'function') return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(reduce){
      confetti({particleCount:60, spread:60, colors:['#C9A15D','#E7BEB7','#FFFDF9']});
      return;
    }
    const duration = 2500;
    const end = Date.now() + duration;
    (function frame(){
      confetti({particleCount:5, angle:60, spread:60, origin:{x:0}, colors:['#C9A15D','#E7BEB7','#FFFDF9']});
      confetti({particleCount:5, angle:120, spread:60, origin:{x:1}, colors:['#C9A15D','#E7BEB7','#FFFDF9']});
      if(Date.now() < end){ requestAnimationFrame(frame); }
    })();
    confetti({particleCount:140, spread:100, origin:{y:0.4}, colors:['#C9A15D','#E7BEB7','#FFFDF9']});
  }
</script>
</body>
</html>
