<!DOCTYPE html>

<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>İyi Ki Doğdun Simay 🌸</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@200;300;400&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #1a1218;
    --petal: #e8a0b0;
    --blush: #f5e6ea;
    --gold: #c9a96e;
    --cream: #faf7f4;
    --mist: #f0eae8;
    --sage: #9eb89e;
  }

- { margin:0; padding:0; box-sizing:border-box; }

html { scroll-behavior: smooth; }

body {
font-family: ‘Jost’, sans-serif;
background: var(–cream);
color: var(–ink);
overflow-x: hidden;
}

/* CONFETTI */
#confetti-canvas {
position: fixed;
top:0; left:0;
width:100%; height:100%;
pointer-events: none;
z-index: 1000;
}

/* ── HERO ── */
.hero {
min-height: 100vh;
display: grid;
grid-template-rows: 1fr auto;
position: relative;
overflow: hidden;
background: var(–ink);
}

.hero-bg {
position: absolute;
inset: 0;
background:
radial-gradient(ellipse 80% 60% at 70% 40%, rgba(232,160,176,0.18) 0%, transparent 60%),
radial-gradient(ellipse 60% 80% at 20% 80%, rgba(158,184,158,0.12) 0%, transparent 50%),
radial-gradient(ellipse 40% 40% at 85% 85%, rgba(201,169,110,0.1) 0%, transparent 50%);
}

.hero-content {
display: flex;
flex-direction: column;
justify-content: center;
align-items: flex-start;
padding: 8rem 6rem 4rem;
position: relative;
z-index: 2;
}

.hero-tag {
font-family: ‘Jost’, sans-serif;
font-weight: 200;
font-size: 0.7rem;
letter-spacing: 0.4em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 2rem;
opacity: 0;
animation: slideIn 1s 0.3s forwards;
}

.hero-name {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(5rem, 14vw, 11rem);
font-weight: 300;
line-height: 0.9;
color: white;
opacity: 0;
animation: slideIn 1s 0.5s forwards;
}

.hero-name em {
font-style: italic;
color: var(–petal);
display: block;
}

.hero-sub {
margin-top: 2.5rem;
font-weight: 200;
font-size: 1rem;
letter-spacing: 0.15em;
color: rgba(255,255,255,0.45);
opacity: 0;
animation: slideIn 1s 0.8s forwards;
}

.hero-scroll {
padding: 2rem 6rem;
position: relative;
z-index: 2;
display: flex;
align-items: center;
gap: 1rem;
opacity: 0;
animation: fadeIn 1s 1.5s forwards;
}

.hero-scroll span {
font-size: 0.65rem;
letter-spacing: 0.3em;
text-transform: uppercase;
color: rgba(255,255,255,0.25);
}

.scroll-line {
width: 60px;
height: 1px;
background: rgba(255,255,255,0.15);
position: relative;
overflow: hidden;
}

.scroll-line::after {
content: ‘’;
position: absolute;
left: -100%;
width: 100%;
height: 100%;
background: var(–gold);
animation: scan 2s 2s infinite;
}

/* ── DIVIDER ── */
.divider {
height: 1px;
background: linear-gradient(90deg, transparent, var(–petal), transparent);
opacity: 0.3;
margin: 0 4rem;
}

/* ── NOTE SECTION ── */
.note-section {
padding: 8rem 0;
background: var(–cream);
width: 100%;
}

.note-inner {
display: grid;
grid-template-columns: 1fr 2fr;
gap: 6rem;
align-items: start;
max-width: 1100px;
margin: 0 auto;
padding: 0 6rem;
}

.note-label {
position: sticky;
top: 4rem;
}

.note-label-text {
font-size: 0.65rem;
letter-spacing: 0.4em;
text-transform: uppercase;
color: var(–gold);
writing-mode: vertical-rl;
transform: rotate(180deg);
}

.note-number {
font-family: ‘Cormorant Garamond’, serif;
font-size: 8rem;
font-weight: 300;
color: var(–mist);
line-height: 1;
margin-top: 1rem;
}

.note-body {}

.note-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(2.5rem, 5vw, 4rem);
font-weight: 300;
line-height: 1.1;
color: var(–ink);
margin-bottom: 2.5rem;
}

.note-title em {
font-style: italic;
color: var(–petal);
}

.note-card {
background: white;
border-radius: 1.5rem;
padding: 3.5rem;
border-left: 3px solid var(–petal);
box-shadow: 0 4px 40px rgba(232,160,176,0.1);
position: relative;
}

.note-quote-mark {
font-family: ‘Cormorant Garamond’, serif;
font-size: 12rem;
color: var(–blush);
position: absolute;
top: -2rem;
left: 2rem;
line-height: 1;
pointer-events: none;
user-select: none;
}

.note-text {
font-family: ‘Cormorant Garamond’, serif;
font-size: 1.35rem;
line-height: 2;
color: #5a3d45;
position: relative;
z-index: 1;
}

.note-sign {
margin-top: 2rem;
font-size: 0.85rem;
letter-spacing: 0.1em;
color: var(–gold);
position: relative;
z-index: 1;
}

/* ── GALLERY ── */
.gallery-section {
padding: 6rem;
background: var(–ink);
position: relative;
overflow: hidden;
}

.gallery-section::before {
content: ‘’;
position: absolute;
inset: 0;
background: radial-gradient(ellipse 70% 50% at 50% 50%, rgba(232,160,176,0.06) 0%, transparent 70%);
}

.gallery-header {
display: flex;
justify-content: space-between;
align-items: flex-end;
margin-bottom: 4rem;
position: relative;
z-index: 1;
}

.gallery-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(2.5rem, 5vw, 4rem);
font-weight: 300;
color: white;
line-height: 1.1;
}

.gallery-title em {
font-style: italic;
color: var(–petal);
}

.gallery-tag {
font-size: 0.65rem;
letter-spacing: 0.4em;
text-transform: uppercase;
color: rgba(255,255,255,0.3);
}

.gallery-grid {
display: grid;
grid-template-columns: 1.2fr 0.9fr 1.1fr;
gap: 1.5rem;
position: relative;
z-index: 1;
}

.photo-frame {
position: relative;
overflow: hidden;
border-radius: 1rem;
cursor: pointer;
}

.photo-frame:nth-child(1) { margin-top: 2rem; }
.photo-frame:nth-child(2) { }
.photo-frame:nth-child(3) { margin-top: 4rem; }

.photo-frame img {
width: 100%; height: 100%;
object-fit: contain;
display: block;
transition: transform 0.6s cubic-bezier(.2,.8,.3,1);
filter: saturate(1.05) brightness(1.05);
}

.photo-frame:hover img {
transform: scale(1.05);
filter: saturate(1.1) brightness(1.08);
}

.photo-frame::after {
content: ‘’;
position: absolute;
inset: 0;
background: linear-gradient(to top, rgba(26,18,24,0.35) 0%, transparent 40%);
pointer-events: none;
}

.photo-caption {
position: absolute;
bottom: 1.25rem;
left: 1.25rem;
z-index: 2;
font-size: 0.65rem;
letter-spacing: 0.25em;
text-transform: uppercase;
color: rgba(255,255,255,0.7);
}

/* ── WISHES ── */
.wishes-section {
padding: 8rem 6rem;
max-width: 100%;
margin: 0 auto;
background: var(–cream);
}

.wishes-inner {
max-width: 1100px;
margin: 0 auto;
}

.wishes-header {
margin-bottom: 4rem;
}

.wishes-tag {
font-size: 0.65rem;
letter-spacing: 0.4em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 1rem;
}

.wishes-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(2.5rem, 5vw, 4rem);
font-weight: 300;
line-height: 1.1;
}

.wishes-title em {
font-style: italic;
color: var(–petal);
}

.wishes-grid {
display: grid;
grid-template-columns: repeat(2, 1fr);
gap: 1.5rem;
}

.wish-item {
padding: 2.5rem;
border: 1px solid rgba(232,160,176,0.2);
border-radius: 1rem;
background: white;
transition: border-color 0.3s, transform 0.3s;
position: relative;
overflow: hidden;
}

.wish-item::before {
content: ‘’;
position: absolute;
top: 0; left: 0;
width: 3px; height: 0;
background: var(–petal);
transition: height 0.4s;
}

.wish-item:hover {
border-color: rgba(232,160,176,0.5);
transform: translateY(-3px);
}

.wish-item:hover::before { height: 100%; }

.wish-icon { font-size: 1.75rem; margin-bottom: 1rem; }

.wish-name {
font-family: ‘Cormorant Garamond’, serif;
font-size: 1.4rem;
font-weight: 400;
margin-bottom: 0.5rem;
color: var(–ink);
}

.wish-desc {
font-size: 0.9rem;
font-weight: 300;
color: #9e8080;
line-height: 1.7;
}

/* ── FOOTER ── */
.footer {
background: var(–ink);
padding: 6rem;
text-align: center;
position: relative;
overflow: hidden;
cursor: pointer;
}

.footer::before {
content: ‘’;
position: absolute;
inset: 0;
background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(232,160,176,0.08) 0%, transparent 70%);
}

.footer-big {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(4rem, 12vw, 9rem);
font-weight: 300;
font-style: italic;
color: white;
line-height: 1;
position: relative;
z-index: 1;
opacity: 0.15;
}

.footer-center {
position: absolute;
inset: 0;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
z-index: 2;
gap: 0.75rem;
}

.footer-icon { font-size: 2rem; }

.footer-text {
font-size: 0.7rem;
letter-spacing: 0.35em;
text-transform: uppercase;
color: rgba(255,255,255,0.4);
}

.footer-sub {
font-family: ‘Cormorant Garamond’, serif;
font-style: italic;
font-size: 1.1rem;
color: var(–petal);
}

.footer-hint {
font-size: 0.6rem;
letter-spacing: 0.2em;
color: rgba(255,255,255,0.15);
margin-top: 0.5rem;
}

/* ── ANIMATIONS ── */
@keyframes slideIn {
from { opacity: 0; transform: translateY(25px); }
to   { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
to { opacity: 1; }
}

@keyframes scan {
to { left: 100%; }
}

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
.hero-content { padding: 6rem 2rem 3rem; }
.hero-scroll { padding: 2rem; }
.note-inner { grid-template-columns: 1fr; padding: 0 2rem; gap: 2rem; }
.note-label { display: none; }
.gallery-section { padding: 4rem 2rem; }
.gallery-grid { grid-template-columns: 1fr; }
.photo-frame:nth-child(1),
.photo-frame:nth-child(2),
.photo-frame:nth-child(3) { margin-top: 0; aspect-ratio: 4/3; }
.wishes-section { padding: 5rem 0; }
.wishes-inner { padding: 0 2rem; }
.wishes-grid { grid-template-columns: 1fr; }
.footer { padding: 4rem 2rem; }
.note-card { padding: 2.5rem 2rem; }
}
</style>

</head>
<body>

<canvas id="confetti-canvas"></canvas>

<!-- HERO -->

<div class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    <p class="hero-tag">✦ Doğum günün kutlu olsun ✦</p>
    <h1 class="hero-name">
      İyi Ki<br>
      <em>Doğdun</em>
      Simay
    </h1>
    <p class="hero-sub">Bugün senin günün &nbsp;🌸</p>
  </div>
  <div class="hero-scroll">
    <div class="scroll-line"></div>
    <span>aşağı kaydır</span>
  </div>
</div>

<!-- NOTE -->

<section class="note-section">
  <div class="note-inner">
  <div class="note-label">
    <span class="note-label-text">Kalpten</span>
    <div class="note-number">01</div>
  </div>
  <div class="note-body">
    <h2 class="note-title">Sana bir şey<br>söylemek <em>istedim…</em></h2>
    <div class="note-card">
      <div class="note-quote-mark">"</div>
      <p class="note-text">
        Bazı insanlar hayatına öğretmen olarak girer, bazıları arkadaş olarak. Sen ikisi birden girdin ve bir de baktım, çok daha fazlası olmuşsun. 🌿<br><br>
        Mangaldaki o duman, sarımsağı ezişin, kafedeki zor seçimin… Seninle vakit geçirmek her zaman güzeldi ve her zaman güzel olacak.<br><br>
        Büyük şeyler olmak zorunda değil, sadece sen buradayken yeterince güzel ve eğlenceli. ✨ Seni tanıdığım için şanslıyım. Yanında olmak, seninle bir şeyler yapmak beni çok mutlu ediyor. Hepsi benim için çok değerliydi.<br><br>
        İyi ki doğdun, iyi ki varsın arkadaşım, öğretmenim ve ablam… 🌸
      </p>
      <p class="note-sign">— Yiğit 🤍</p>
    </div>
  </div>
  </div>
</section>

<div class="divider"></div>

<!-- GALLERY -->

<section class="gallery-section">
  <div class="gallery-header">
    <h2 class="gallery-title">Bizim<br><em>Anılarımız</em></h2>
    <span class="gallery-tag">✦ 02 / Anılar</span>
  </div>
  <div class="gallery-grid">
    <div class="photo-frame">
      <img src="data:image/jpeg;base64," alt="Mangal anısı">
      <span class="photo-caption">Mangal 🔥</span>
    </div>
    <div class="photo-frame">
      <img src="data:image/jpeg;base64," alt="Tatlı an">
      <span class="photo-caption">Tatlı an 🤍</span>
    </div>
    <div class="photo-frame">
      <img src="data:image/jpeg;base64," alt="Kafede">
      <span class="photo-caption">Kafede ☕</span>
    </div>
  </div>
</section>

<div class="divider"></div>

<!-- WISHES -->

<section class="wishes-section">
  <div class="wishes-inner">
  <div class="wishes-header">
    <p class="wishes-tag">✦ 03 / Dilekler</p>
    <h2 class="wishes-title">Sana neler<br><em>diliyorum…</em></h2>
  </div>
  <div class="wishes-grid">
    <div class="wish-item">
      <div class="wish-icon">🌟</div>
      <div class="wish-name">Sağlık</div>
      <div class="wish-desc">Her zaman sağlıklı, dinç ve enerjik olmanı diliyorum.</div>
    </div>
    <div class="wish-item">
      <div class="wish-icon">💫</div>
      <div class="wish-name">Mutluluk</div>
      <div class="wish-desc">Hayatın boyunca gülümsemene neden olacak anlar dolu olsun.</div>
    </div>
    <div class="wish-item">
      <div class="wish-icon">🌺</div>
      <div class="wish-name">Başarı</div>
      <div class="wish-desc">Hedeflediğin her şeye ulaşmanı, hayallerini yaşamanı diliyorum.</div>
    </div>
    <div class="wish-item">
      <div class="wish-icon">🤍</div>
      <div class="wish-name">Sevgi</div>
      <div class="wish-desc">Her zaman sevildiğini hisset, çünkü gerçekten seviliyorsun.</div>
    </div>
  </div>
  </div>
</section>

<!-- FOOTER -->

<div class="footer" onclick="burstConfetti()">
  <div class="footer-big">Simay</div>
  <div class="footer-center">
    <span class="footer-icon">🌸</span>
    <span class="footer-text">İyi ki doğdun, iyi ki varsın</span>
    <span class="footer-sub">— Yiğit</span>
    <span class="footer-hint">konfeti için tıkla ✨</span>
  </div>
</div>

<script>
// ── CONFETTI ──
const canvas = document.getElementById('confetti-canvas');
const ctx = canvas.getContext('2d');
canvas.width = window.innerWidth;
canvas.height = window.innerHeight;
window.addEventListener('resize', () => { canvas.width=window.innerWidth; canvas.height=window.innerHeight; });

const COLORS = ['#e8a0b0','#c9a96e','#9eb89e','#f5e6ea','#ffe082','#ce93d8','#ffffff'];
const SHAPES = ['circle','rect','tri'];

class P {
  constructor(burst) {
    this.burst = burst;
    this.reset();
  }
  reset() {
    if(this.burst) {
      this.x = window.innerWidth/2 + (Math.random()-0.5)*200;
      this.y = window.innerHeight/2 + (Math.random()-0.5)*100;
      const a = Math.random()*Math.PI*2;
      const sp = Math.random()*12+4;
      this.vx = Math.cos(a)*sp;
      this.vy = Math.sin(a)*sp - 6;
    } else {
      this.x = Math.random()*canvas.width;
      this.y = -20;
      this.vx = (Math.random()-0.5)*2;
      this.vy = Math.random()*2+1;
    }
    this.size = Math.random()*8+4;
    this.color = COLORS[Math.floor(Math.random()*COLORS.length)];
    this.shape = SHAPES[Math.floor(Math.random()*SHAPES.length)];
    this.rot = Math.random()*Math.PI*2;
    this.rs = (Math.random()-0.5)*0.15;
    this.alpha = 1;
    this.gravity = 0.15;
    this.dead = false;
  }
  update() {
    this.vy += this.gravity;
    this.x += this.vx;
    this.y += this.vy;
    this.rot += this.rs;
    if(this.burst) {
      this.alpha -= 0.012;
      if(this.alpha <= 0) this.dead = true;
    } else {
      if(this.y > canvas.height+20) this.dead = true;
    }
  }
  draw() {
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.rot);
    ctx.globalAlpha = Math.max(0, this.alpha);
    ctx.fillStyle = this.color;
    if(this.shape==='circle') {
      ctx.beginPath(); ctx.arc(0,0,this.size/2,0,Math.PI*2); ctx.fill();
    } else if(this.shape==='rect') {
      ctx.fillRect(-this.size/2,-this.size/4,this.size,this.size/2);
    } else {
      ctx.beginPath(); ctx.moveTo(0,-this.size/2); ctx.lineTo(this.size/2,this.size/2); ctx.lineTo(-this.size/2,this.size/2); ctx.closePath(); ctx.fill();
    }
    ctx.restore();
  }
}

let particles = [];
let animId = null;

function loop() {
  ctx.clearRect(0,0,canvas.width,canvas.height);
  particles = particles.filter(p => !p.dead);
  particles.forEach(p => { p.update(); p.draw(); });
  if(particles.length > 0) animId = requestAnimationFrame(loop);
  else { ctx.clearRect(0,0,canvas.width,canvas.height); animId=null; }
}

function startRain() {
  for(let i=0;i<100;i++) { const p = new P(false); p.y = Math.random()*canvas.height; particles.push(p); }
  if(!animId) animId = requestAnimationFrame(loop);
  setTimeout(()=>{ particles=particles.filter(p=>p.burst); }, 5000);
}

function burstConfetti() {
  for(let i=0;i<160;i++) particles.push(new P(true));
  if(!animId) animId = requestAnimationFrame(loop);
}

startRain();
</script>

</body>
