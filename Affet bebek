<!DOCTYPE html>

<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>İyi ki doğdun, Sakina 🌸</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Italiana&family=Quicksand:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --rose: #f2a7bb;
    --deep-rose: #c9607a;
    --blush: #fde8ef;
    --gold: #c9a84c;
    --gold-light: #f0d078;
    --cream: #fdf6f0;
    --text: #4a2535;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--cream);
    color: var(--text);
    font-family: 'Quicksand', sans-serif;
    overflow-x: hidden;
    cursor: none;
  }
  .cursor {
    width: 18px; height: 18px;
    background: var(--gold);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: transform 0.1s ease;
    mix-blend-mode: multiply;
  }
  .petal {
    position: fixed;
    pointer-events: none;
    z-index: 0;
    font-size: 1.2rem;
    animation: floatDown linear infinite;
    opacity: 0.6;
  }
  @keyframes floatDown {
    0% { transform: translateY(-40px) rotate(0deg); opacity: 0; }
    10% { opacity: 0.6; }
    90% { opacity: 0.4; }
    100% { transform: translateY(110vh) rotate(360deg); opacity: 0; }
  }

/* HERO */
#hero {
min-height: 100vh;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
position: relative;
background: linear-gradient(135deg, #fde8ef 0%, #fdf6f0 50%, #fef3e2 100%);
overflow: hidden;
text-align: center;
padding: 2rem;
}
#hero::before {
content: ‘’;
position: absolute; inset: 0;
background:
radial-gradient(ellipse at 20% 30%, rgba(249,167,187,0.35) 0%, transparent 60%),
radial-gradient(ellipse at 80% 70%, rgba(201,168,76,0.2) 0%, transparent 50%);
}
.hero-badge {
font-size: 0.75rem;
letter-spacing: 0.35em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 1.5rem;
opacity: 0;
animation: fadeUp 1s ease 0.3s forwards;
}
.hero-name {
font-family: ‘Italiana’, serif;
font-size: clamp(5rem, 18vw, 12rem);
color: var(–deep-rose);
line-height: 0.9;
opacity: 0;
animation: fadeUp 1s ease 0.6s forwards;
position: relative;
}
.hero-name span {
display: block;
font-family: ‘Cormorant Garamond’, serif;
font-style: italic;
font-size: clamp(1.5rem, 5vw, 3rem);
color: var(–gold);
letter-spacing: 0.1em;
margin-top: 0.5rem;
}
.hero-subtitle {
font-size: clamp(0.9rem, 2.5vw, 1.1rem);
color: var(–deep-rose);
letter-spacing: 0.15em;
margin-top: 2rem;
font-weight: 300;
opacity: 0;
animation: fadeUp 1s ease 1s forwards;
}
.scroll-hint {
position: absolute;
bottom: 2.5rem;
left: 50%;
transform: translateX(-50%);
display: flex;
flex-direction: column;
align-items: center;
gap: 0.5rem;
opacity: 0;
animation: fadeUp 1s ease 1.5s forwards;
}
.scroll-hint span { font-size: 0.65rem; letter-spacing: 0.3em; color: var(–gold); text-transform: uppercase; }
.scroll-line {
width: 1px; height: 50px;
background: linear-gradient(to bottom, var(–gold), transparent);
animation: scrollPulse 2s ease infinite;
}
@keyframes scrollPulse {
0%, 100% { opacity: 0.3; } 50% { opacity: 1; }
}
.gold-ring {
position: absolute;
border-radius: 50%;
border: 1px solid rgba(201,168,76,0.25);
animation: pulse-ring 6s ease infinite;
}
.gold-ring:nth-child(1) { width: 300px; height: 300px; top: 10%; right: 5%; }
.gold-ring:nth-child(2) { width: 180px; height: 180px; bottom: 15%; left: 8%; animation-delay: 2s; }
.gold-ring:nth-child(3) { width: 80px; height: 80px; top: 30%; left: 15%; animation-delay: 4s; }
@keyframes pulse-ring {
0%, 100% { transform: scale(1); opacity: 0.4; }
50% { transform: scale(1.08); opacity: 0.8; }
}

/* LETTER */
#letter {
padding: 8rem 2rem;
background: linear-gradient(180deg, var(–cream) 0%, #fde8ef 100%);
display: flex;
flex-direction: column;
align-items: center;
}
.section-label {
font-size: 0.7rem;
letter-spacing: 0.4em;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 3rem;
display: flex;
align-items: center;
gap: 1rem;
}
.section-label::before, .section-label::after {
content: ‘’; width: 40px; height: 1px; background: var(–gold);
}
.letter-card {
max-width: 680px;
width: 100%;
background: #fff;
border-radius: 2px;
padding: 4rem;
position: relative;
box-shadow: 0 4px 6px rgba(242,167,187,0.1), 0 20px 60px rgba(242,167,187,0.15), inset 0 0 0 1px rgba(201,168,76,0.15);
opacity: 0;
transform: translateY(40px);
transition: opacity 0.8s ease, transform 0.8s ease;
}
.letter-card.visible { opacity: 1; transform: translateY(0); }
.letter-card::before {
content: ‘❝’;
position: absolute;
top: -1.5rem; left: 2.5rem;
font-size: 5rem;
color: var(–rose);
font-family: ‘Cormorant Garamond’, serif;
opacity: 0.5;
}
.letter-greeting {
font-family: ‘Cormorant Garamond’, serif;
font-style: italic;
font-size: 1.4rem;
color: var(–deep-rose);
margin-bottom: 1.5rem;
}
.letter-body {
font-family: ‘Cormorant Garamond’, serif;
font-size: 1.15rem;
line-height: 1.9;
color: #5a3040;
font-weight: 300;
}
.letter-signature {
margin-top: 2.5rem;
font-family: ‘Cormorant Garamond’, serif;
font-style: italic;
font-size: 1.2rem;
color: var(–gold);
text-align: right;
}

/* GALLERY */
#gallery {
padding: 8rem 2rem;
background: var(–blush);
display: flex;
flex-direction: column;
align-items: center;
}
.gallery-title {
font-family: ‘Italiana’, serif;
font-size: clamp(2.5rem, 7vw, 5rem);
color: var(–deep-rose);
text-align: center;
margin-bottom: 1rem;
opacity: 1;
transform: translateY(0);
transition: opacity 0.8s ease, transform 0.8s ease;
}
.gallery-title.visible { opacity: 1; transform: translateY(0); }
.gallery-sub {
font-size: 0.85rem;
letter-spacing: 0.2em;
color: var(–gold);
text-transform: uppercase;
margin-bottom: 4rem;
opacity: 0;
transition: opacity 0.8s ease 0.2s;
}
.gallery-sub.visible { opacity: 1; }

/* Masonry-style grid */
.gallery-grid {
display: grid;
grid-template-columns: repeat(12, 1fr);
grid-template-rows: auto;
gap: 1rem;
max-width: 960px;
width: 100%;
}
.gallery-item {
border-radius: 3px;
overflow: hidden;
position: relative;
opacity: 0;
transform: scale(0.95) translateY(20px);
transition: opacity 0.7s ease, transform 0.7s ease, box-shadow 0.3s ease;
box-shadow: 0 4px 20px rgba(201,100,120,0.15);
cursor: zoom-in;
}
.gallery-item.visible { opacity: 1; transform: scale(1) translateY(0); }
.gallery-item:hover { transform: scale(1.02) translateY(-4px); box-shadow: 0 12px 40px rgba(201,100,120,0.3); z-index: 2; }
.gallery-item img {
width: 100%; height: 100%;
object-fit: cover;
display: block;
transition: transform 0.5s ease;
}
.gallery-item:hover img { transform: scale(1.05); }

/* Caption overlay */
.gallery-item .caption {
position: absolute;
bottom: 0; left: 0; right: 0;
padding: 1.5rem 1rem 1rem;
background: linear-gradient(transparent, rgba(74,37,53,0.7));
color: #fff;
font-family: ‘Cormorant Garamond’, serif;
font-style: italic;
font-size: 0.95rem;
letter-spacing: 0.05em;
opacity: 0;
transition: opacity 0.3s ease;
}
.gallery-item:hover .caption { opacity: 1; }

/* Grid layout */
.gi-1 { grid-column: 1 / 6; grid-row: 1; aspect-ratio: 4/5; }
.gi-2 { grid-column: 6 / 13; grid-row: 1 / 3; aspect-ratio: 3/4; }
.gi-3 { grid-column: 1 / 7; grid-row: 2; aspect-ratio: 16/9; }
.gi-4 { grid-column: 7 / 13; grid-row: 3; aspect-ratio: 3/4; }
.gi-5-placeholder { display: none; }

@media (max-width: 700px) {
.gallery-grid { grid-template-columns: 1fr 1fr; }
.gi-1, .gi-2, .gi-3, .gi-4 { grid-column: auto; grid-row: auto; aspect-ratio: 1; }
}

/* LIGHTBOX */
.lightbox {
display: none;
position: fixed; inset: 0;
background: rgba(0,0,0,0.92);
z-index: 10000;
align-items: center;
justify-content: center;
padding: 2rem;
}
.lightbox.open { display: flex; }
.lightbox img {
max-width: 90vw;
max-height: 90vh;
object-fit: contain;
border-radius: 2px;
box-shadow: 0 0 60px rgba(242,167,187,0.3);
}
.lightbox-close {
position: absolute;
top: 1.5rem; right: 2rem;
color: #fff;
font-size: 2rem;
cursor: pointer;
opacity: 0.7;
background: none;
border: none;
transition: opacity 0.2s;
}
.lightbox-close:hover { opacity: 1; }

/* SONG */
#song {
padding: 8rem 2rem;
background: linear-gradient(135deg, #fde8ef, #fdf6f0);
display: flex;
flex-direction: column;
align-items: center;
text-align: center;
}
.song-card {
max-width: 580px;
width: 100%;
padding: 3.5rem;
border: 1px solid rgba(201,168,76,0.3);
border-radius: 2px;
background: rgba(255,255,255,0.6);
backdrop-filter: blur(10px);
opacity: 0;
transform: translateY(30px);
transition: opacity 0.8s ease, transform 0.8s ease;
}
.song-card.visible { opacity: 1; transform: translateY(0); }
.note-icon { font-size: 3rem; display: block; margin-bottom: 1.5rem; animation: bounce-note 2s ease infinite; }
@keyframes bounce-note {
0%, 100% { transform: translateY(0) rotate(-5deg); }
50% { transform: translateY(-8px) rotate(5deg); }
}
.song-title {
font-family: ‘Italiana’, serif;
font-size: 2.2rem;
color: var(–deep-rose);
margin-bottom: 0.3rem;
}
.song-artist { font-size: 0.85rem; letter-spacing: 0.2em; color: var(–gold); text-transform: uppercase; margin-bottom: 2rem; }
.song-lyrics {
font-family: ‘Cormorant Garamond’, serif;
font-style: italic;
font-size: 1.3rem;
line-height: 1.8;
color: #5a3040;
border-top: 1px solid rgba(201,168,76,0.2);
border-bottom: 1px solid rgba(201,168,76,0.2);
padding: 1.5rem 0;
margin-bottom: 1.5rem;
}
.song-from { font-size: 0.75rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(–gold); opacity: 0.7; }

/* FOOTER */
footer {
background: var(–deep-rose);
padding: 5rem 2rem;
text-align: center;
position: relative;
overflow: hidden;
}
footer::before {
content: ‘Sakina’;
position: absolute;
font-family: ‘Italiana’, serif;
font-size: 18rem;
color: rgba(255,255,255,0.04);
top: 50%; left: 50%;
transform: translate(-50%, -50%);
white-space: nowrap;
pointer-events: none;
}
.footer-message {
font-family: ‘Cormorant Garamond’, serif;
font-style: italic;
font-size: clamp(2rem, 6vw, 4rem);
color: #fff;
line-height: 1.3;
position: relative;
z-index: 1;
}
.footer-hearts {
font-size: 1.5rem;
letter-spacing: 0.5rem;
margin-top: 1.5rem;
animation: heartbeat 1.5s ease infinite;
display: block;
position: relative;
z-index: 1;
}
@keyframes heartbeat {
0%, 100% { transform: scale(1); } 25% { transform: scale(1.15); }
}
.footer-sub {
margin-top: 1rem;
font-size: 0.75rem;
letter-spacing: 0.3em;
text-transform: uppercase;
color: rgba(255,255,255,0.4);
position: relative;
z-index: 1;
}

@keyframes fadeUp {
from { opacity: 0; transform: translateY(30px); }
to { opacity: 1; transform: translateY(0); }
}
.confetti-piece {
position: fixed;
width: 10px; height: 10px;
top: -10px;
pointer-events: none;
z-index: 1000;
animation: confettiFall linear forwards;
}
@keyframes confettiFall {
to { transform: translateY(110vh) rotate(720deg); opacity: 0; }
}
</style>

</head>
<body>

<div class="cursor" id="cursor"></div>
<div id="petals"></div>

<!-- Lightbox -->

<div class="lightbox" id="lightbox">
  <button class="lightbox-close" id="lbClose">✕</button>
  <img id="lbImg" src="" alt="">
</div>

<!-- HERO -->

<section id="hero">
  <div class="gold-ring"></div>
  <div class="gold-ring"></div>
  <div class="gold-ring"></div>
  <p class="hero-badge">✦ Bugün çok özel bir gün ✦</p>
  <h1 class="hero-name">
    Sakina
    <span>İyi ki doğdun, civcivim 🐣</span>
  </h1>
  <p class="hero-subtitle">Rusya'dan da olsa · Kalbimde hep yanımdasın</p>
  <div class="scroll-hint">
    <span>keşfet</span>
    <div class="scroll-line"></div>
  </div>
</section>

<!-- LETTER -->

<section id="letter">
  <div class="section-label">Sana bir mektup</div>
  <div class="letter-card">
    <p class="letter-greeting">Töpeke,</p>
    <p class="letter-body">
      2 yıldır her gün saatlerce konuşuyoruz ama bir kez bile yüz yüze görüşmedik. Bunu birine anlatsam kimse bu kadar yakın olup hiç görüşmediğimize inanmaz. Hayatımda en güzel ve en eğlenceli şeylerden birisin. 🐶<br><br>
      Rusya'da yaşıyorsun, ben buradayım, aramızda binlerce kilometre var. Ama telefon açılınca, mesaj gelince o mesafe yok oluyor. Saatlerce konuşuyoruz, saçmalıyoruz, pis tucu tucu diyoruz birbirimize ve bu, yüz yüze görüştüğüm pek çok insandan daha gerçek hissettiriyor. 🌍<br><br>
      Kuçu kuçu, köpek, töpek, pis poklu tuçu — bunlar aramızdaki dilin en tatlı kelimeleri. Başkası anlamaz, anlamaması da gerekmiyor. (Bir daha birine söylediğini duyarsam ağzına sicarım.) Bu bize özel. 🐾<br><br>
      Henüz pikniğimizi yapamadık. Bu düşündükçe içim sıkışıyor. Ama o gün gelecek ve o gün geldiğinde seni ne kadar ısıracağımı, ne kadar güleceğimizi hep bekliyorum. O ana kadar: iyi ki doğdun, iyi ki varsın, iyi ki benim töpekimsin. 💛
    </p>
    <p class="letter-signature">— Senin pis tucu tucu kankan 🐾</p>
  </div>
</section>

<!-- GALLERY -->

<section id="gallery">
  <div class="section-label">Bakıyorum da</div>
  <h2 class="gallery-title">Kankamın fotoğrafları</h2>
  <p class="gallery-sub">Sadece sen 🐾</p>

  <div class="gallery-grid">
    <div class="gallery-item gi-1" onclick="openLb(this)">
      <img src="data:image/jpeg;base64," alt="Sakina 1">
      <div class="caption">Kaş boyatırken bile güzelsin köpek 🐶😂</div>
    </div>
    <div class="gallery-item gi-2" onclick="openLb(this)">
      <img src="data:image/jpeg;base64," alt="Sakina 2">
      <div class="caption">Ne kadar güzelsin 💛</div>
    </div>
    <div class="gallery-item gi-3" onclick="openLb(this)">
      <img src="data:image/jpeg;base64," alt="Sakina 3">
      <div class="caption">Bir gün orada seni bulacağım 🇷🇺💛</div>
    </div>
    <div class="gallery-item gi-4" onclick="openLb(this)">
      <img src="data:image/jpeg;base64," alt="Sakina 4">
      <div class="caption">Birthday girl 👑</div>
    </div>
  </div>
</section>

<!-- SONG -->

<section id="song">
  <div class="section-label">Seninle dinlemek istediğim</div>
  <div class="song-card">
    <span class="note-icon">🎵</span>
    <h3 class="song-title">Küçük Civcivim</h3>
    <p class="song-artist">Sana özel · Her zaman</p>
    <p class="song-lyrics">
      "Küçük civcivim güzel kızım<br>
      dünyam benim<br>
      canım kankammm"
    </p>
    <p class="song-from">♡ Senin şarkın · Hep öyle kalacak</p>
  </div>
</section>

<!-- FOOTER -->

<footer>
  <p class="footer-message">
    Doğum günün<br>kutlu olsun,<br>
    <em>Sakina.</em>
  </p>
  <span class="footer-hearts">🌸 💛 🌸</span>
  <p class="footer-sub">Rusya'dan da olsa · Hep yanımdasın · Sonsuza kadar 🐾</p>
</footer>

<script>
  // Custom cursor
  const cursor = document.getElementById('cursor');
  document.addEventListener('mousemove', e => {
    cursor.style.left = e.clientX + 'px';
    cursor.style.top = e.clientY + 'px';
  });

  // Floating petals
  const petalsContainer = document.getElementById('petals');
  const emojis = ['🌸','🌷','✨','💛','🐣','🌺'];
  function createPetal() {
    const p = document.createElement('div');
    p.className = 'petal';
    p.textContent = emojis[Math.floor(Math.random() * emojis.length)];
    p.style.left = Math.random() * 100 + 'vw';
    p.style.fontSize = (0.8 + Math.random() * 1.2) + 'rem';
    const dur = 8 + Math.random() * 10;
    p.style.animationDuration = dur + 's';
    p.style.animationDelay = Math.random() * 5 + 's';
    petalsContainer.appendChild(p);
    setTimeout(() => p.remove(), (dur + 5) * 1000);
  }
  for (let i = 0; i < 12; i++) createPetal();
  setInterval(createPetal, 2000);

  // Scroll reveal
  const obs = new IntersectionObserver(entries => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) setTimeout(() => e.target.classList.add('visible'), i * 100);
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.letter-card,.gallery-title,.gallery-sub,.gallery-item,.song-card').forEach(el => obs.observe(el));

  // Lightbox
  function openLb(el) {
    const img = el.querySelector('img');
    document.getElementById('lbImg').src = img.src;
    document.getElementById('lightbox').classList.add('open');
  }
  document.getElementById('lbClose').onclick = () => document.getElementById('lightbox').classList.remove('open');
  document.getElementById('lightbox').onclick = function(e) {
    if (e.target === this) this.classList.remove('open');
  };

  // Confetti
  function launchConfetti() {
    const colors = ['#f2a7bb','#c9a84c','#f0d078','#c9607a','#fde8ef'];
    for (let i = 0; i < 60; i++) {
      setTimeout(() => {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';
        piece.style.left = Math.random() * 100 + 'vw';
        piece.style.background = colors[Math.floor(Math.random() * colors.length)];
        piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
        piece.style.width = (6 + Math.random() * 8) + 'px';
        piece.style.height = (6 + Math.random() * 8) + 'px';
        piece.style.animationDuration = (3 + Math.random() * 4) + 's';
        document.body.appendChild(piece);
        setTimeout(() => piece.remove(), 8000);
      }, i * 60);
    }
  }
  window.addEventListener('load', () => setTimeout(launchConfetti, 800));
</script>

</body>
</html>
